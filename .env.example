# Copia questo file in .env e compila i valori. NON committare .env.

# Server SMTP (default: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=30

# Credenziali: per Gmail usare una "Password per le app" a 16 caratteri, senza spazi
SMTP_USER=ictcosmopol@gmail.com
SMTP_PASSWORD=gagevhrpaejweqzq

# Mittente (opzionale, default = SMTP_USER)
SMTP_FROM=
SMTP_FROM_NAME=Servizio Notifiche

# Oggetto usato quando il chiamante non ne specifica uno
EMAIL_DEFAULT_SUBJECT=Notifica automatica

# Copia conoscenza applicata quando il chiamante non specifica 'cc'.
# "none" per non mettere nessuno in copia per default.
EMAIL_DEFAULT_CC=ict@cosmopol.it

# Log degli invii (data/ora + destinatari). Percorso del file di log:
# lascia vuoto per il default logs/email.log, usa "none" per scrivere solo su console.
EMAIL_LOG_FILE=
EMAIL_LOG_LEVEL=INFO

# Chiave per proteggere l'API REST (header X-API-Key).
# Se vuota, l'endpoint /send-email resta aperto: impostala se esponi il servizio in rete.
EMAIL_API_KEY=
